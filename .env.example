# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.
# ─────────────────────────────────────────────────

# Google Gemini API key (required)
GOOGLE_API_KEY=your_api_key_here

# Model settings (optional – defaults shown)
# GEMINI_MODEL_NAME=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004
# GEMINI_TEMPERATURE=0.3
# GEMINI_MAX_TOKENS=1024

# Tesseract OCR path (optional – auto-detected on Linux/macOS)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Poppler path (optional – only needed on Windows)
# POPPLER_PATH=C:\Program Files\poppler\Library\bin

# Storage directory for session-isolated FAISS indices
# STORAGE_DIR=./storage/sessions

# Text chunking (optional)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# CSV_ROWS_PER_CHUNK=20

# Embedding pipeline
# EMBED_BATCH_SIZE=20
# EMBED_RETRY_ATTEMPTS=3
# EMBED_RETRY_BACKOFF=2.0

# Retrieval
# RETRIEVAL_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=0.6

# Upload limits
# MAX_UPLOAD_SIZE_MB=50

# Session cache
# MAX_CACHED_SESSIONS=50
